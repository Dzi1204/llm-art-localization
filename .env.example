# ── OCR Backend ─────────────────────────────────────────────────────────────
# Set endpoint to switch from EasyOCR (local) to Azure Document Intelligence.
# Auth: leave KEY blank to use DefaultAzureCredential (az login — recommended).
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ── Translation Backend ──────────────────────────────────────────────────────
# Azure OpenAI — auth via DefaultAzureCredential (az login), no key needed.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-global
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── QE Scoring ───────────────────────────────────────────────────────────────
# Auth: DefaultAzureCredential (az login — no token needed).
# Leave QE_ENDPOINT blank to disable QE scoring.
QE_ENDPOINT=
QE_BEARER_TOKEN=
QE_SCORE_THRESHOLD=0.7

# ── Languages ────────────────────────────────────────────────────────────────
# Comma-separated list of target languages.
TARGET_LANGUAGES=it-IT
# TARGET_LANGUAGES=it-IT,de-DE,fr-FR
